      {/* Nút đóng X */}
      <button id="close-email-modal" aria-label="Đóng" class="absolute top-4 right-4 text-neutral-400 hover:text-neutral-700 p-1 rounded-full hover:bg-neutral-100 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <h3 class="text-base font-bold text-neutral-900 mb-1">Contact via Email</h3>
      <p class="text-xs text-neutral-500 mb-4 select-all font-medium">mintby1j@gmail.com</p>

      <div class="flex flex-col gap-2.5">
        {/* Nút 1: Copy Email */}
        <button id="copy-email-btn" type="button" class="w-full flex items-center justify-center gap-2 rounded-xl bg-neutral-900 text-white py-2.5 px-4 text-xs font-semibold hover:bg-neutral-800 transition-colors cursor-pointer">
          <span id="copy-email-text">Copy Email Address</span>
        </button>

        {/* Nút 2: Mở thẳng Gmail trên trình duyệt */}
        <a
          href="https://mail.google.com/mail/?view=cm&fs=1&to=mintby1j@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 rounded-xl bg-neutral-100 text-neutral-800 py-2.5 px-4 text-xs font-semibold hover:bg-neutral-200 transition-colors"
        >
          Open in Gmail (Web)
        </a>

        {/* Nút 3: Mở ứng dụng Mail mặc định trên thiết bị */}
        <a
          href="mailto:mintby1j@gmail.com"
          class="w-full flex items-center justify-center gap-2 rounded-xl border border-neutral-200 text-neutral-600 py-2 px-4 text-xs font-medium hover:bg-neutral-50 transition-colors"
