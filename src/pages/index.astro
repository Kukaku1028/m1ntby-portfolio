        id="open-email-modal"
        type="button"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium bg-white hover:bg-neutral-50 text-neutral-600 rounded-full border border-neutral-200 transition-all shadow-2xs cursor-pointer"
