---
import Layout from "@layouts/Layout.astro";
import { SITE_CONTENT } from "@config"; // Đã import SITE_CONTENT ở đây[cite: 9]
import "../styles/global.css";
---

<Layout>
  {/* Khung chính mở rộng để chứa thoải mái 3 cột */}
  <main class="max-w-[1600px] mx-auto px-8 lg:px-16 py-12 lg:py-16 flex flex-col lg:flex-row lg:gap-20 gap-12">

    
    {/* ================= CỘT TRÁI: Thông tin cá nhân & Mạng xã hội ================= */}
  <aside class="w-full lg:w-[280px] lg:shrink-0 lg:sticky lg:top-16 h-fit flex flex-col items-start">
    {/* Avatar */}
    <img
      src="/avatar.png"
      alt="Avatar"
      class="w-32 h-32 rounded-full object-cover border border-neutral-200/80 mb-5"
    />

    {/* Tên & Chức danh */}
<h1 class="text-3xl font-bold tracking-tight text-neutral-900 mb-1">M1ntby</h1>
<p class="text-sm font-normal text-neutral-500 mb-4">
  Illustrator & Editor 
</p>

{/* Đoạn Bio chính - Đổi thành text-sm cho dễ đọc */}
<p class="text-sm font-normal text-neutral-600 leading-relaxed mb-5">
  Anime/VTuber-style Digital Illustrator.<br />
  Video Editor specializing in MVs & lyric videos.
</p>

{/* Phần Tools & Trạng thái */}
