{/* Copyright tinh tế */}
<div class="mt-5 text-[11px] text-neutral-400">
  © 2026 M1ntby
</div>
  </aside>

    
    {/* ================= CỘT PHẢI: Danh mục bộ lọc & Lưới tác phẩm ================= */}
    <section class="flex-1 min-w-0">
      
{/* Cụm nút tab phân loại chuẩn */}
  <div class="relative flex items-center p-1 rounded-full w-fit mb-8">
    {/* Viên thuốc nền đen trượt động */}
