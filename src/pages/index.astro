      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>
    {/* Giao diện 1: Dành cho Illustration (Cuộn zoom & kéo thả) */}
    <div id="lightbox-container" class="relative hidden items-center justify-center w-full h-full cursor-grab active:cursor-grabbing">
      <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[92vw] object-contain rounded-xl shadow-2xl transition-transform duration-75 ease-out origin-center" />
    </div>

    {/* Giao diện 2: Dành cho Video YouTube + Nút X nằm ở dưới giống hình mẫu */}
    <div id="video-lightbox-container" class="relative hidden flex-col items-center justify-center w-full h-full gap-5">
