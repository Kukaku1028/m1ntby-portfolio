</Layout>

{/* Đoạn mã JavaScript xử lý hiệu ứng bấm lọc danh mục */}
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    const projectCards = document.querySelectorAll<HTMLElement>(".project-card");
    const pill = document.getElementById("tab-pill") as HTMLElement;

    function movePill(targetBtn: HTMLButtonElement) {
      if (!pill) return;
      pill.style.width = `${targetBtn.offsetWidth}px`;
      pill.style.transform = `translateX(${targetBtn.offsetLeft - 4}px)`;
    }

    const activeBtn = document.querySelector<HTMLButtonElement>('.tab-btn[data-filter="all"]');

    if (activeBtn) {
      activeBtn.classList.add("active", "text-white");
      activeBtn.classList.remove("text-neutral-500", "hover:text-neutral-900");
      setTimeout(() => movePill(activeBtn), 50);
    }
const featuredHighlights = document.getElementById("featured-highlights");
    function updateFeaturedHighlights(filter: string | null) {
      if (!featuredHighlights) return;
      featuredHighlights.style.display = filter === "all" ? "block" : "none";
    }
    updateFeaturedHighlights("all");
    // Lọc hiển thị ban đầu
    projectCards.forEach((card) => {
      const isFeatured = card.getAttribute("data-featured") === "true";
      card.style.display = isFeatured ? "block" : "none";
    });

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.getAttribute("data-filter");
        updateFeaturedHighlights(filter);

        // Reset tất cả các nút về trạng thái bình thường (xám + có hiệu ứng hover đổi màu)
        filterButtons.forEach((btn) => {
          btn.classList.remove("active", "text-white");
          // Thêm lại class hover chuẩn cho nút không active
          btn.classList.add("text-neutral-500", "hover:text-neutral-900");
        });

        // Kích hoạt nút được bấm: Biến chữ thành màu trắng và QUAN TRỌNG: Xóa sạch hiệu ứng hover để không bị đen chữ
        button.classList.add("active", "text-white");
        button.classList.remove("text-neutral-500", "hover:text-neutral-900");

        movePill(button);

        // Lọc hiển thị danh sách dự án
        projectCards.forEach((card) => {
          const category = card.getAttribute("data-category");
          const isFeatured = card.getAttribute("data-featured") === "true";

          if (filter === "all") {
            card.style.display = isFeatured ? "block" : "none";
          } else {
            card.style.display = category === filter ? "block" : "none";
          }
        });
      });
    });
// --- Xử lý Lightbox phân tách nút đóng cho Illustration và Video ---
    const lightbox = document.getElementById("image-lightbox");
    const lightboxContainer = document.getElementById("lightbox-container");
    const videoLightboxContainer = document.getElementById("video-lightbox-container");
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const youtubeIframe = document.getElementById("youtube-iframe") as HTMLIFrameElement;
    const closeLightboxBtn = document.getElementById("close-lightbox");
    const closeVideoBtn = document.getElementById("close-video-btn");

    let scale = 1;
    let pointX = 0;
    let pointY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    function updateTransform() {
      if (!lightboxImg) return;
      lightboxImg.style.transform = `translate(${pointX}px, ${pointY}px) scale(${scale})`;
    }

    function resetZoomAndPan() {
      scale = 1;
      pointX = 0;
      pointY = 0;
      updateTransform();
    }

    function getEmbedUrl(url: string) {
      if (!url) return "";
      let videoId = "";
      if (url.includes("youtu.be/")) {
        videoId = url.split("youtu.be/")[1]?.split("?")[0];
      } else if (url.includes("watch?v=")) {
        videoId = url.split("watch?v=")[1]?.split("&")[0];
      }
      return videoId ? `https://www.youtube.com/embed/${videoId}?autoplay=1` : url;
    }

    function openIllustrationLightbox(imgSrc: string, imgAlt: string) {
      if (!lightbox || !lightboxContainer || !videoLightboxContainer || !lightboxImg || !closeLightboxBtn) return;
      
      lightboxContainer.classList.remove("hidden");
      lightboxContainer.classList.add("flex");
      videoLightboxContainer.classList.add("hidden");
      videoLightboxContainer.classList.remove("flex");

      // Hiện nút X góc trên, ẩn nút X dưới
      closeLightboxBtn.style.display = "block";

      lightboxImg.src = imgSrc;
      lightboxImg.alt = imgAlt;
      resetZoomAndPan();

      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      requestAnimationFrame(() => {
        lightbox.classList.remove("opacity-0");
      });
    }

    function openVideoLightbox(videoUrl: string) {
      if (!lightbox || !lightboxContainer || !videoLightboxContainer || !youtubeIframe || !closeLightboxBtn) return;

      videoLightboxContainer.classList.remove("hidden");
      videoLightboxContainer.classList.add("flex");
      lightboxContainer.classList.add("hidden");
      lightboxContainer.classList.remove("flex");

      // Ẩn nút X góc trên, để lộ hoàn toàn giao diện player video và nút X ở dưới
      closeLightboxBtn.style.display = "none";

      youtubeIframe.src = getEmbedUrl(videoUrl);

      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      requestAnimationFrame(() => {
        lightbox.classList.remove("opacity-0");
      });
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add("opacity-0");
      setTimeout(() => {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        if (lightboxImg) lightboxImg.src = "";
        if (youtubeIframe) youtubeIframe.src = "";
        resetZoomAndPan();
      }, 200);
    }

    // Cuộn chuột Zoom ảnh
    lightboxContainer?.addEventListener("wheel", (e) => {
      e.preventDefault();
      const zoomIntensity = 0.15;
      if (e.deltaY < 0) {
        scale = Math.min(scale + zoomIntensity, 5);
      } else {
        scale = Math.max(scale - zoomIntensity, 1);
        if (scale === 1) {
          pointX = 0;
          pointY = 0;
        }
      }
      updateTransform();
    }, { passive: false });

    // Kéo thả ảnh khi zoom
    lightboxContainer?.addEventListener("mousedown", (e) => {
      if (scale > 1) {
        isDragging = true;
        startX = e.clientX - pointX;
        startY = e.clientY - pointY;
        e.preventDefault();
      }
    });

    lightboxContainer?.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      pointX = e.clientX - startX;
      pointY = e.clientY - startY;
      updateTransform();
    });

    lightboxContainer?.addEventListener("mouseup", () => { isDragging = false; });
    lightboxContainer?.addEventListener("mouseleave", () => { isDragging = false; });

    // Lắng nghe click trên card dự án
    projectCards.forEach((card) => {
      card.addEventListener("click", (e) => {
        const category = card.getAttribute("data-category");
        e.preventDefault();

        if (category === "illustration") {
          const imgSrc = card.getAttribute("data-image") || "";
          const imgTitle = card.getAttribute("data-title") || "";
          openIllustrationLightbox(imgSrc, imgTitle);
        } else if (category === "video") {
          const videoUrl = card.getAttribute("href") || "";
          openVideoLightbox(videoUrl);
        }
      });
    });

    closeLightboxBtn?.addEventListener("click", closeLightbox);
    closeVideoBtn?.addEventListener("click", closeLightbox);
    
    lightbox?.addEventListener("click", (e) => {
      if (e.target === lightbox || e.target === lightboxContainer || e.target === videoLightboxContainer) {
        closeLightbox();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
        closeLightbox();
      }
    });
    // --- Xử lý hộp thoại tùy chọn Email ---
    const openEmailBtn = document.getElementById("open-email-modal");
    const emailModal = document.getElementById("email-modal");
    const closeEmailBtn = document.getElementById("close-email-modal");
    const copyEmailBtn = document.getElementById("copy-email-btn");
    const copyEmailText = document.getElementById("copy-email-text");

    function showEmailModal() {
      if (!emailModal) return;
      emailModal.classList.remove("hidden");
      emailModal.classList.add("flex");
      requestAnimationFrame(() => emailModal.classList.remove("opacity-0"));
    }

    function hideEmailModal() {
      if (!emailModal) return;
      emailModal.classList.add("opacity-0");
      setTimeout(() => {
        emailModal.classList.add("hidden");
        emailModal.classList.remove("flex");
        if (copyEmailText) copyEmailText.textContent = "Copy Email Address";
      }, 200);
    }

    openEmailBtn?.addEventListener("click", showEmailModal);
    closeEmailBtn?.addEventListener("click", hideEmailModal);
    emailModal?.addEventListener("click", (e) => {
      if (e.target === emailModal) hideEmailModal();
    });

    copyEmailBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("mintby1j@gmail.com");
        if (copyEmailText) copyEmailText.textContent = "Copied to clipboard!";
      } catch (err) {
        if (copyEmailText) copyEmailText.textContent = "mintby1j@gmail.com";
      }
    });
    // --- Nút mũi tên chuyển ảnh / video trong Lightbox ---
    const prevLightboxBtn = document.getElementById("lightbox-prev");
    const nextLightboxBtn = document.getElementById("lightbox-next");
    let currentCardIndex = -1;

    function getVisibleCards() {
      return Array.from(projectCards).filter((card) => card.style.display !== "none");
    }

    function openCardAt(index: number) {
      const visibleCards = getVisibleCards();
      if (!visibleCards.length) return;

      currentCardIndex = (index + visibleCards.length) % visibleCards.length;
      const targetCard = visibleCards[currentCardIndex];
      const category = targetCard.getAttribute("data-category");

      resetZoomAndPan();

      if (category === "illustration") {
        const imgSrc = targetCard.getAttribute("data-image") || "";
        const imgTitle = targetCard.getAttribute("data-title") || "";
        openIllustrationLightbox(imgSrc, imgTitle);
      } else if (category === "video") {
        const videoUrl = targetCard.getAttribute("href") || "";
        openVideoLightbox(videoUrl);
      }
    }

    projectCards.forEach((card) => {
      card.addEventListener("click", () => {
        const visibleCards = getVisibleCards();
        currentCardIndex = visibleCards.indexOf(card);
      });
    });

    prevLightboxBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      openCardAt(currentCardIndex - 1);
    });

    nextLightboxBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      openCardAt(currentCardIndex + 1);
    });

    document.addEventListener("keydown", (e) => {
      if (!lightbox || lightbox.classList.contains("hidden")) return;
      if (e.key === "ArrowLeft") {
        openCardAt(currentCardIndex - 1);
      } else if (e.key === "ArrowRight") {
        openCardAt(currentCardIndex + 1);
      }
    });
  });
</script>