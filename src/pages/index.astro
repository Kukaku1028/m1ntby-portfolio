        class="mb-6 rounded-xl bg-neutral-50/90 border border-neutral-200/70 p-3.5 space-y-2 text-xs text-neutral-600 leading-relaxed"
      >
        <div>
          <span class="font-semibold text-neutral-800">MV Editor</span>
          <span class="text-neutral-400"> — </span>
          <span>Directed &amp; edited Amane Kanata Graduation Fanmade MV (10+ collaborators, 15K+ views).</span>
        </div>
        <div>
          <span class="font-semibold text-neutral-800">Lyric Video &amp; Subtitling</span>
          <span class="text-neutral-400"> — </span>
          <span>Produced &amp; timed Vietnamese-subtitled lyric videos (<em>Your Petal</em>, <em>Newton</em>, <em>Kyun Kyun MIKO Kyun kyun♡</em>).</span>
        </div>
        <div>
          <span class="font-semibold text-neutral-800">Community Founder &amp; Event Host</span>
          <span class="text-neutral-400"> — </span>
          <span>Founder of MCS; organized &amp; designed print assets for an offline Hololive Fan Viewing Party in Ho Chi Minh City.</span>
        </div>
      </div>

      {/* Lưới hiển thị 3 cột chuẩn Masonry */}
  <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
    {SITE_CONTENT.projects.map((project) => (
      <a
        href={project.category === "video" ? project.linkPreview : "#"}
        target={project.category === "video" ? "_blank" : undefined}
        rel={project.category === "video" ? "noopener noreferrer" : undefined}
        data-category={project.category}
        data-featured={project.featured ? "true" : "false"}
        data-image={project.image}
        data-title={project.name}
        class="project-card group relative block break-inside-avoid overflow-hidden rounded-2xl bg-white border border-neutral-200/80 shadow-xs cursor-pointer"
      >
        {/* Ảnh tác phẩm */}
        <img
          src={project.image}
          alt={project.name}
          class="w-full h-auto block transition-transform duration-500 ease-out group-hover:scale-105"
        />

        {/* Hiệu ứng Hover: Hiện tên dự án + vai trò */}
        <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/80 via-black/30 to-transparent p-5 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
          <h3 class="text-base font-bold text-white translate-y-2 transition-transform duration-300 group-hover:translate-y-0">
            {project.name}
          </h3>
          <p class="text-xs font-medium text-neutral-300 translate-y-2 transition-transform duration-300 delay-75 group-hover:translate-y-0">
            {project.summary}
