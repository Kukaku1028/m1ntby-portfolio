        <svg class="w-3.5 h-3.5 text-neutral-500 shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67zM22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/>
        </svg>
        Mail
      </button>
    <a href="https://discord.gg/AqfZXTRq" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium bg-white hover:bg-neutral-50 text-neutral-600 rounded-full border border-neutral-200 transition-all shadow-2xs">
